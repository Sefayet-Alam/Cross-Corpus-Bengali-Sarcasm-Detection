        <mxCell id="FGCeM1oUuyjFOZ_fBE1J-2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=Comic Sans MS;fontSize=14;fontColor=#000000;align=center;verticalAlign=top;spacing=8;" value="&lt;b&gt;&lt;font&gt;1. Corpora and splits&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ben-Sarc • BanglaSarc • BanglaSarc3&lt;br&gt;&lt;br&gt;Harmonise to a binary label space&lt;br&gt;(drop BanglaSarc3 neutral)&lt;br&gt;&lt;br&gt;Normalised exact-match deduplication&lt;br&gt;and label-conflict removal&lt;br&gt;&lt;br&gt;Frozen stratified 80/10/10 splits,&lt;br&gt;hashed and reused everywhere" vertex="1">
