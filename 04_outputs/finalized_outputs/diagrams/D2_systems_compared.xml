        <mxCell id="b23Va0gJ9b99xPEQdqbP-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F5;strokeColor=#6B7280;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;arcSize=6;spacing=8;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Pooled-all&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;One model trained on all three corpora and evaluated on&lt;br&gt;each test set in turn. Every evaluation corpus contributed&lt;br&gt;labelled training data, so this is a known-target&lt;br&gt;engineering comparator rather than a fifth remedy." vertex="1">
          <mxGeometry height="189" width="360" x="256" y="578" as="geometry" />
        </mxCell>
        <mxCell id="b23Va0gJ9b99xPEQdqbP-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F5;strokeColor=#6B7280;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;arcSize=6;spacing=8;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Target-supervised adaptation&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;Each source model fine-tuned on k ∈ {0, 25, 50, 100, 250,&lt;br&gt;500, 1000} labelled target examples, drawn from the target&lt;br&gt;&lt;i&gt;train&lt;/i&gt; split only. Fixed schedule, no target validation set.&lt;br&gt;Recovery measured against the target-trained reference." vertex="1">
          <mxGeometry height="214" width="364" x="678" y="565.5" as="geometry" />
        </mxCell>
        <mxCell id="b23Va0gJ9b99xPEQdqbP-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F5;strokeColor=#6B7280;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;arcSize=6;spacing=8;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Target-only control&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;The same labelled subsets and seeds, but starting from the&lt;br&gt;pretrained encoder with a &lt;i&gt;newly initialised head&lt;/i&gt;. The arms&lt;br&gt;differ in whole-model initialisation: the source arm carries&lt;br&gt;both a source-trained encoder and a source-trained head." vertex="1">
