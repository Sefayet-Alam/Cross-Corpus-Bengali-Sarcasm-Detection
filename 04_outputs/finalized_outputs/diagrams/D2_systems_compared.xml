        <mxCell id="b23Va0gJ9b99xPEQdqbP-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;arcSize=6;spacing=8;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;1  Adversarial fine-tuning&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;Adds an L2-normalised perturbation of&lt;br&gt;size ε = 0.5 to the embedding matrix&lt;br&gt;each step, then a second backward pass&lt;br&gt;&lt;br&gt;&lt;i&gt;Compared against:&lt;/i&gt; the identical run&lt;br&gt;without the perturbation (&quot;vanilla&quot;),&lt;br&gt;on the same 10 seeds" vertex="1">
          <mxGeometry height="284" width="262" x="256" y="207" as="geometry" />
        </mxCell>
        <mxCell id="b23Va0gJ9b99xPEQdqbP-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;arcSize=6;spacing=8;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;2  Multi-source pooling (LOCO)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;Trains on two corpora concatenated,&lt;br&gt;evaluates on the fully held-out third&lt;br&gt;&lt;br&gt;Overlap filter widens to the union of&lt;br&gt;both sources&lt;br&gt;&lt;br&gt;3 folds × 5 seeds" vertex="1">
          <mxGeometry height="275" width="262" x="616" y="211.5" as="geometry" />
        </mxCell>
        <mxCell id="b23Va0gJ9b99xPEQdqbP-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;arcSize=6;spacing=8;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;3  Domain-adversarial (GRL)&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;br&gt;Adds a domain head behind a gradient&lt;br&gt;reversal layer, so the encoder is pushed&lt;br&gt;to hide which corpus an item came from&lt;br&gt;&lt;br&gt;Run inside LOCO, so this tests domain&lt;br&gt;&lt;i style=&quot;&quot;&gt;generalisation&lt;/i&gt;, not target-aware&lt;br&gt;adaptation&lt;/font&gt;" vertex="1">
          <mxGeometry height="271" width="262" x="959" y="213.5" as="geometry" />
        </mxCell>
        <mxCell id="b23Va0gJ9b99xPEQdqbP-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#444444;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;arcSize=6;spacing=8;" value="&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;b style=&quot;&quot;&gt;4  Threshold recalibration&lt;/b&gt;&lt;br&gt;&lt;/font&gt;&lt;br&gt;Sweeps 91 thresholds from 0.05 to 0.95&lt;br&gt;on &lt;i&gt;source&lt;/i&gt; validation data, applies the&lt;br&gt;winner unchanged to every target&lt;br&gt;&lt;br&gt;One threshold per source and seed;&lt;br&gt;no target information enters" vertex="1">
          <mxGeometry height="201" width="288" x="1276" y="248.5" as="geometry" />
        </mxCell>
        <mxCell id="b23Va0gJ9b99xPEQdqbP-8" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#111111;whiteSpace=wrap;" value="&lt;b&gt;Arms that do see target data&lt;/b&gt;&#xa;&lt;font&gt;reported separately, and not counted among the four&lt;/font&gt;" vertex="1">
          <mxGeometry height="139" width="197" x="15" y="603" as="geometry" />
